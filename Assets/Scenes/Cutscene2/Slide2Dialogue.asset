  m_Script: {fileID: 11500000, guid: 71538442a108cf245bf5b66c9780c8da, type: 3}
  m_Name: Slide2Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Unknown
  speakerNameVietnamese: 
  speakerAvatar: {fileID: -3635613324321525249, guid: 1342e76c75a39e548a8aac6024da959a, type: 3}
  lines:
  - Looking toward the distant horizon, Atto realized their safety was only temporary.
  - Furious at the defeat, King Aldren was assembling a massive army, an overwhelming
    force too large for a single flock to fight.
  - To survive the king's wrath, they had to abandon the only home they had ever
    known.
  - As the sun set, Atto led the hesitant flock away from their peaceful pastures
    and toward the dark forest ahead.
  vietnameseLines: []
